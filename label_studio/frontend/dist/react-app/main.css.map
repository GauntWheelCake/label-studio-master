.create-project
  flex: 1
  min-height: 0
  display: flex
  flex-direction: column
  > .modal__header
    border-bottom: 1px solid $black_10
    display: flex
    align-items: center
    justify-content: space-between
    padding: 16px 24px
    h1
      margin-bottom: 0
      margin-top: 0
      font-size: 20px
      flex-shrink: 0
    button
      line-height: 1em
      min-width: 100px
      flex-shrink: 0
  &__body
    flex: 1
    min-height: 0
    overflow-y: auto
    padding: 24px
  &__footer
    border-top: 1px solid $black_10
    padding: 16px 24px
    display: flex
    justify-content: flex-end
  form.project-name
    width: 500px
    margin: 32px auto
  form.project-name > *:not(:first-child)
    margin-top: 32px

.wizard-steps
  display: flex
  align-items: center
  justify-content: center
  flex: 1
  margin: 0 24px
  gap: 40px

.wizard-step
  display: flex
  align-items: center
  justify-content: center
  height: 40px
  padding: 0 28px
  border-radius: 20px
  font-size: 14px
  font-weight: 500
  border: none
  cursor: default
  transition: all 0.2s ease
  white-space: nowrap
  background: transparent
  outline: none
  font-family: inherit
  min-width: 160px
  gap: 8px
  svg
    display: block
    flex-shrink: 0
    width: 16px
    height: 16px
  span
    display: block
    line-height: 16px
    height: 16px
  &_completed
    background: $accent_color
    color: #fff
    box-shadow: 0 2px 8px rgba($accent_color, 0.35)
    cursor: pointer
    &:hover
      background: linear-gradient(0deg, rgba(#fff, 0.1), rgba(#fff, 0.1)), $accent_color
  &_current
    background: rgba($accent_color, 0.06)
    color: $accent_color
    border: 2px solid $accent_color
    font-weight: 600
  &_pending
    background: #fff
    color: $grey_6
    border: 1px solid $grey_5

.wizard-step__arrow
  color: $grey_8
  display: flex
  align-items: center
  opacity: 0.9
  padding: 0 4px
