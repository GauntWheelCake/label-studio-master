# Label Studio API 地址（在同一 docker-compose 网络下可用 app:8080）
LABEL_STUDIO_URL=http://app:8080

# Label Studio API Token（建议使用项目级或专用服务账号 Token）
LABEL_STUDIO_API_TOKEN=replace-with-your-token

# 模型服务配置
ML_BACKEND_PORT=9090
ML_BACKEND_URL=http://ml-backend:9090
MODEL_VERSION=faster-rcnn-resnet50-v1.0
CONFIDENCE_THRESHOLD=0.7
