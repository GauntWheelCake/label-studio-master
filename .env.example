# Shared administrator mode
ENABLE_SHARED_ADMIN_MODE=true
SHARED_ADMIN_EMAIL=shared-admin@huibiaosystem.local
SHARED_ADMIN_USERNAME=shared-admin
SHARED_ORGANIZATION_TITLE=Hui Biao Shared

# Replace this value before deployment. Keep it private and no longer than 40 characters.
SHARED_ADMIN_FIXED_TOKEN=replace-with-private-token

# Optional external host, for example: http://example.com
LABEL_STUDIO_HOST=
